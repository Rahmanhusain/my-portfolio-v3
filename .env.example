# Copy this file to .env.local and replace the placeholder values.

# Site metadata used by the app, sitemap, robots, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://yourname.dev

# ─── Content database ────────────────────────────────────────────────────────
# Shared with the admin panel — both apps must point at the same database.
# Leave MONGODB_URI unset to run entirely from the bundled content/*.json files.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Shared secret the admin panel sends as `x-revalidate-secret` when it POSTs to
# /api/revalidate after a content change. Must match ADMIN's REVALIDATE_SECRET.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=replace_with_a_long_random_string

# Public base URL of the Cloudflare R2 bucket that stores uploaded images.
# Used to whitelist the host for next/image. Must match the admin panel's value.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ─── Notifications ───────────────────────────────────────────────────────────

# Contact form + booking notifications via Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Contact form notifications via Resend email.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Rahman Portfolio <onboarding@resend.dev>"

# Optional secret phrase for the hidden easter egg endpoint.
CAT_SECRET_PHRASE=i love you
