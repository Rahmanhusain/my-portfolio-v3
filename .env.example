# Copy this file to .env.local and replace the placeholder values.

# Site metadata used by the app, sitemap, robots, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://yourname.dev

# Contact form + booking notifications via Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Contact form notifications via Resend email.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Rahman Portfolio <onboarding@resend.dev>"

# Optional secret phrase for the hidden easter egg endpoint.
CAT_SECRET_PHRASE=i love you
